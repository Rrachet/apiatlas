{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apiatlas.dev/schema/api.schema.json",
  "title": "apiatlas API record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "category", "website", "docs", "auth", "pricing", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "website": {"type": "string", "format": "uri"},
    "docs": {"type": "string", "format": "uri"},
    "auth": {"type": "string", "enum": ["none", "api-key", "oauth2", "basic", "bearer", "custom"]},
    "pricing": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "beta", "deprecated"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"}
  }
}
